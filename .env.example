# MongoDB connection string. This is the only variable the application needs.
# The database name is taken from the URI itself; when the URI carries none,
# "personal_finance" is used.
#
# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/personal_finance
#
# Local MongoDB with authentication:
# MONGODB_URI=mongodb://user:password@127.0.0.1:27017/personal_finance?authSource=admin
#
# MongoDB Atlas:
# MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/personal_finance?retryWrites=true&w=majority
